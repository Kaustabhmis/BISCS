<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BISCS India - Software & Tools</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Print Styles for Invoice */
        @media print {
            .no-print, nav, footer, .ad-banner, .sidebar { display: none !important; }
            .print-full { width: 100% !important; grid-column: span 3 !important; }
            .tool-container { box-shadow: none !important; border: none !important; padding: 0 !important; }
            body { background: white; }
        }

        /* Animations */
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        
        .hidden-page { display: none; }
    </style>
</head>
<body class="bg-white text-slate-900 flex flex-col min-h-screen">

    <!-- Navigation -->
    <nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center cursor-pointer" onclick="navigateTo('home')">
                    <i data-lucide="cpu" class="h-8 w-8 text-blue-400 mr-2"></i>
                    <span class="font-bold text-xl tracking-tight">BISCS <span class="text-blue-400">India</span></span>
                </div>
                
                <div class="hidden md:flex space-x-8">
                    <button onclick="navigateTo('home')" class="text-gray-300 hover:text-white transition font-medium nav-btn" id="nav-home">Home</button>
                    <button onclick="navigateTo('store')" class="text-gray-300 hover:text-white transition font-medium nav-btn" id="nav-store">Software Store</button>
                    <button onclick="navigateTo('tools')" class="text-gray-300 hover:text-white transition font-medium nav-btn" id="nav-tools">Free Tools</button>
                </div>

                <div class="md:hidden">
                    <button onclick="toggleMobileMenu()">
                        <i data-lucide="menu"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-slate-800">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <button onclick="navigateTo('home'); toggleMobileMenu()" class="block w-full text-left px-3 py-2 rounded-md hover:bg-slate-700">Home</button>
                <button onclick="navigateTo('store'); toggleMobileMenu()" class="block w-full text-left px-3 py-2 rounded-md hover:bg-slate-700">Software Store</button>
                <button onclick="navigateTo('tools'); toggleMobileMenu()" class="block w-full text-left px-3 py-2 rounded-md hover:bg-slate-700">Free Tools</button>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow fade-in" id="main-content">
        
        <!-- HOME PAGE -->
        <div id="page-home" class="page-section">
            <!-- Hero -->
            <div class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-20 px-4">
                <div class="max-w-7xl mx-auto text-center">
                    <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
                        Manage Teams Efficiently with <br/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">DomeBox</span>
                    </h1>
                    <p class="text-xl text-blue-100 mb-10 max-w-2xl mx-auto">
                        India's premier Team Task Management System. Streamline operations, boost productivity, and access our suite of free business tools.
                    </p>
                    <div class="flex flex-col sm:flex-row justify-center gap-4">
                        <button onclick="navigateTo('store')" class="px-8 py-4 bg-blue-500 hover:bg-blue-600 rounded-lg font-bold shadow-lg shadow-blue-500/30 transition transform hover:-translate-y-1 flex items-center justify-center">
                            Get DomeBox <i data-lucide="arrow-right" class="ml-2 h-5 w-5"></i>
                        </button>
                        <button onclick="navigateTo('tools')" class="px-8 py-4 bg-slate-700 hover:bg-slate-600 border border-slate-500 rounded-lg font-bold transition transform hover:-translate-y-1 flex items-center justify-center">
                            Use Free Tools <i data-lucide="zap" class="ml-2 h-5 w-5 text-yellow-400"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Insert Store Section Content Here via JS or duplicating HTML -->
            <div id="home-store-placeholder"></div>
            
            <div class="bg-slate-50 border-t border-slate-200">
                 <!-- Insert Tools Dashboard Content Here via JS or duplicating HTML -->
                 <div id="home-tools-placeholder"></div>
            </div>
        </div>

        <!-- STORE PAGE -->
        <div id="page-store" class="page-section hidden-page">
            <div class="max-w-7xl mx-auto px-4 py-16">
                <div class="text-center mb-16">
                    <h2 class="text-3xl md:text-4xl font-bold text-slate-800">Our Premium Solutions</h2>
                    <p class="text-slate-600 mt-4 text-lg">Enterprise-grade software designed to scale your business.</p>
                </div>

                <!-- DomeBox Card -->
                <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-3xl overflow-hidden shadow-2xl text-white mb-16">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center p-8 md:p-12">
                        <div class="space-y-6">
                            <div class="inline-flex items-center space-x-2 bg-white/20 px-4 py-2 rounded-full text-sm font-medium backdrop-blur-sm border border-white/20">
                                <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
                                <span>Flagship Product</span>
                            </div>
                            <h3 class="text-4xl md:text-5xl font-extrabold tracking-tight">DomeBox</h3>
                            <p class="text-blue-100 text-lg leading-relaxed font-light">
                                The ultimate <strong>Team Task Management System</strong> for Indian businesses. Assign tasks, track progress in real-time, and streamline collaboration across your entire organization.
                            </p>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                                <div class="flex items-center space-x-3"><div class="bg-blue-500/30 p-2 rounded-lg"><i data-lucide="check-square" class="h-5 w-5"></i></div><span class="font-medium">Task Tracking</span></div>
                                <div class="flex items-center space-x-3"><div class="bg-blue-500/30 p-2 rounded-lg"><i data-lucide="users" class="h-5 w-5"></i></div><span class="font-medium">Team Collab</span></div>
                                <div class="flex items-center space-x-3"><div class="bg-blue-500/30 p-2 rounded-lg"><i data-lucide="bar-chart" class="h-5 w-5"></i></div><span class="font-medium">Analytics</span></div>
                                <div class="flex items-center space-x-3"><div class="bg-blue-500/30 p-2 rounded-lg"><i data-lucide="shield" class="h-5 w-5"></i></div><span class="font-medium">Secure Cloud</span></div>
                            </div>
                            <div class="pt-6">
                                <a href="https://www.domebox.in" target="_blank" class="inline-flex items-center bg-white text-blue-700 px-8 py-4 rounded-xl font-bold hover:bg-blue-50 transition shadow-lg transform hover:-translate-y-1 w-full sm:w-auto justify-center">
                                    Visit DomeBox.in <i data-lucide="globe" class="ml-2 h-5 w-5"></i>
                                </a>
                                <p class="mt-3 text-sm text-blue-200 opacity-80">Boost your team's productivity today.</p>
                            </div>
                        </div>
                        <!-- Graphic -->
                        <div class="relative h-64 md:h-96 bg-white/10 rounded-2xl flex items-center justify-center backdrop-blur-md border border-white/10 shadow-inner">
                            <div class="absolute top-4 right-4 text-white/20"><i data-lucide="layout" class="h-16 w-16"></i></div>
                            <div class="text-center p-8 z-10">
                                <div class="flex justify-center mb-6 relative">
                                    <div class="absolute inset-0 bg-blue-400 blur-3xl opacity-30 rounded-full"></div>
                                    <div class="bg-white p-4 rounded-2xl shadow-xl relative z-10"><i data-lucide="bar-chart" class="h-20 w-20 text-blue-600"></i></div>
                                </div>
                                <h4 class="text-2xl font-bold mb-2">Visualize Success</h4>
                                <p class="text-blue-100">Take control of your projects with DomeBox's intuitive dashboard.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Features -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                    <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100">
                        <div class="bg-blue-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-blue-600"><i data-lucide="check-circle" class="h-6 w-6"></i></div>
                        <h4 class="font-bold text-lg text-slate-800 mb-2">Easy to Use</h4>
                        <p class="text-slate-600 text-sm">Designed with simplicity in mind so your team can start working immediately.</p>
                    </div>
                    <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100">
                        <div class="bg-purple-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-purple-600"><i data-lucide="zap" class="h-6 w-6"></i></div>
                        <h4 class="font-bold text-lg text-slate-800 mb-2">Fast Performance</h4>
                        <p class="text-slate-600 text-sm">Lightning fast load times ensure you never lose momentum.</p>
                    </div>
                    <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100">
                        <div class="bg-green-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-green-600"><i data-lucide="smartphone" class="h-6 w-6"></i></div>
                        <h4 class="font-bold text-lg text-slate-800 mb-2">Mobile Ready</h4>
                        <p class="text-slate-600 text-sm">Manage your team from anywhere with our fully responsive design.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOOLS PAGE (Dashboard) -->
        <div id="page-tools" class="page-section hidden-page">
            <div class="max-w-7xl mx-auto px-4 py-12">
                <div class="text-center mb-12">
                    <h2 class="text-3xl font-bold text-slate-800">Free Online Tools</h2>
                    <p class="text-slate-600 mt-2">Simple, powerful utilities for your daily tasks.</p>
                </div>
                
                <div id="tools-grid-container" class="space-y-12">
                    <!-- Tools will be injected here by JS -->
                </div>
                
                <!-- Ad Banner -->
                <div class="w-full bg-gray-100 border-2 border-dashed border-gray-300 rounded-lg p-4 my-6 flex flex-col items-center justify-center text-gray-400 h-24 sm:h-32 animate-pulse no-print">
                    <span class="text-sm font-semibold uppercase tracking-wider text-center">Google Ad Space (Footer)</span>
                </div>
            </div>
        </div>

        <!-- INDIVIDUAL TOOLS SECTIONS -->

        <!-- 1. GST Calculator -->
        <div id="tool-gst" class="tool-view hidden-page">
            <div class="max-w-4xl mx-auto px-4 py-8">
                <button onclick="navigateTo('tools')" class="text-slate-500 hover:text-slate-800 mb-6 flex items-center transition no-print"><i data-lucide="arrow-left" class="h-4 w-4 mr-1"></i> Back to Tools</button>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="lg:col-span-2">
                        <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-slate-100">
                            <h1 class="text-2xl font-bold text-slate-800 mb-6 border-b pb-4">GST Calculator</h1>
                            <div class="space-y-4">
                                <div><label class="block text-sm font-medium text-slate-700 mb-1">Amount (₹)</label><input type="number" id="gst-amount" class="w-full p-3 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Enter amount" oninput="calculateGST()"></div>
                                <div><label class="block text-sm font-medium text-slate-700 mb-1">GST Rate (%)</label>
                                    <select id="gst-rate" class="w-full p-3 border rounded-lg outline-none" onchange="calculateGST()">
                                        <option value="3">3%</option><option value="5">5%</option><option value="12">12%</option><option value="18" selected>18%</option><option value="28">28%</option>
                                    </select>
                                </div>
                                <div class="flex space-x-4">
                                    <button onclick="setGstType('exclusive')" id="btn-exclusive" class="flex-1 py-2 rounded-lg font-medium transition bg-blue-600 text-white">GST Exclusive</button>
                                    <button onclick="setGstType('inclusive')" id="btn-inclusive" class="flex-1 py-2 rounded-lg font-medium transition bg-slate-100 text-slate-600">GST Inclusive</button>
                                </div>
                                <div class="mt-6 p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                                    <div class="flex justify-between"><span>Net Amount:</span> <span class="font-bold" id="gst-net">₹0.00</span></div>
                                    <div class="flex justify-between text-blue-600"><span>GST Amount:</span> <span class="font-bold" id="gst-val">₹0.00</span></div>
                                    <div class="flex justify-between text-xl font-bold border-t pt-2 mt-2"><span>Total:</span> <span id="gst-total">₹0.00</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Sidebar -->
                    <div class="lg:col-span-1 no-print">
                        <div class="sticky top-24">
                            <div class="w-full bg-gray-100 border-2 border-dashed border-gray-300 rounded-lg p-4 my-6 flex flex-col items-center justify-center text-gray-400 h-32 animate-pulse"><span class="text-xs font-bold text-slate-400">Google Ad Space</span></div>
                            <div class="bg-blue-50 border border-blue-100 p-6 rounded-xl mb-6">
                                <h4 class="font-bold text-blue-900 mb-2">Try DomeBox Today</h4>
                                <p class="text-sm text-blue-700 mb-4">Streamline your team's workflow.</p>
                                <button onclick="navigateTo('store')" class="text-xs font-bold bg-blue-600 text-white px-4 py-2 rounded uppercase w-full">View Software</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. EMI Calculator -->
        <div id="tool-emi" class="tool-view hidden-page">
             <div class="max-w-4xl mx-auto px-4 py-8">
                <button onclick="navigateTo('tools')" class="text-slate-500 hover:text-slate-800 mb-6 flex items-center transition no-print"><i data-lucide="arrow-left" class="h-4 w-4 mr-1"></i> Back to Tools</button>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="lg:col-span-2">
                        <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-slate-100">
                            <h1 class="text-2xl font-bold text-slate-800 mb-6 border-b pb-4">Loan / EMI Calculator</h1>
                            <div class="space-y-4">
                                <div><label class="block text-sm font-medium text-slate-700 mb-1">Loan Amount (₹)</label><input type="number" id="emi-p" value="100000" class="w-full p-3 border rounded-lg outline-none" oninput="calculateEMI()"></div>
                                <div><label class="block text-sm font-medium text-slate-700 mb-1">Interest Rate (% p.a)</label><input type="number" id="emi-r" value="10" class="w-full p-3 border rounded-lg outline-none" oninput="calculateEMI()"></div>
                                <div><label class="block text-sm font-medium text-slate-700 mb-1">Tenure (Months)</label><input type="number" id="emi-t" value="12" class="w-full p-3 border rounded-lg outline-none" oninput="calculateEMI()"></div>
                                <div class="mt-6 grid grid-cols-2 gap-4">
                                    <div class="bg-blue-50 p-4 rounded-lg text-center"><div class="text-sm text-blue-600 font-bold uppercase">Monthly EMI</div><div class="text-2xl font-bold text-slate-800" id="emi-val">₹0</div></div>
                                    <div class="bg-green-50 p-4 rounded-lg text-center"><div class="text-sm text-green-600 font-bold uppercase">Total Interest</div><div class="text-2xl font-bold text-slate-800" id="emi-interest">₹0</div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                     <div class="lg:col-span-1 no-print">
                         <div class="sticky top-24">
                            <div class="w-full bg-gray-100 border-2 border-dashed border-gray-300 rounded-lg p-4 my-6 flex flex-col items-center justify-center text-gray-400 h-32 animate-pulse"><span class="text-xs font-bold text-slate-400">Google Ad Space</span></div>
                            <div class="bg-blue-50 border border-blue-100 p-6 rounded-xl mb-6">
                                <h4 class="font-bold text-blue-900 mb-2">Try DomeBox Today</h4>
                                <button onclick="navigateTo('store')" class="text-xs font-bold bg-blue-600 text-white px-4 py-2 rounded uppercase w-full">View Software</button>
                            </div>
                         </div>
                     </div>
                </div>
            </div>
        </div>

        <!-- 3. Discount Calculator -->
        <div id="tool-discount" class="tool-view hidden-page">
            <div class="max-w-4xl mx-auto px-4 py-8">
               <button onclick="navigateTo('tools')" class="text-slate-500 hover:text-slate-800 mb-6 flex items-center transition no-print"><i data-lucide="arrow-left" class="h-4 w-4 mr-1"></i> Back to Tools</button>
               <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                   <div class="lg:col-span-2">
                       <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-slate-100">
                           <h1 class="text-2xl font-bold text-slate-800 mb-6 border-b pb-4">Discount Calculator</h1>
                           <div class="space-y-4">
                                <div class="grid grid-cols-2 gap-4">
                                   <div>
                                      <label class="block text-sm font-medium text-slate-700 mb-1">Original Price</label>
                                      <input type="number" id="disc-price" class="w-full p-3 border rounded-lg outline-none" placeholder="0.00" oninput="calculateDiscount()">
                                   </div>
                                   <div>
                                      <label class="block text-sm font-medium text-slate-700 mb-1">Discount (%)</label>
                                      <input type="number" id="disc-percent" class="w-full p-3 border rounded-lg outline-none" placeholder="0" oninput="calculateDiscount()">
                                   </div>
                                </div>
                                <div class="bg-slate-800 text-white p-6 rounded-xl mt-4">
                                    <div class="flex justify-between items-center mb-2">
                                        <span class="text-slate-400">You Save</span>
                                        <span class="font-bold text-green-400" id="disc-saved">₹0.00</span>
                                    </div>
                                    <div class="flex justify-between items-center text-2xl font-bold border-t border-slate-700 pt-4">
                                        <span>Payable</span>
                                        <span id="disc-final">₹0.00</span>
                                    </div>
                                </div>
                           </div>
                       </div>
                   </div>
                   <div class="lg:col-span-1 no-print">
                       <div class="sticky top-24">
                          <div class="w-full bg-gray-100 border-2 border-dashed border-gray-300 rounded-lg p-4 my-6 flex flex-col items-center justify-center text-gray-400 h-32 animate-pulse"><span class="text-xs font-bold text-slate-400">Google Ad Space</span></div>
                          <div class="bg-blue-50 border border-blue-100 p-6 rounded-xl mb-6">
                              <h4 class="font-bold text-blue-900 mb-2">Try DomeBox Today</h4>
                              <button onclick="navigateTo('store')" class="text-xs font-bold bg-blue-600 text-white px-4 py-2 rounded uppercase w-full">View Software</button>
                          </div>
                       </div>
                   </div>
               </div>
            </div>
        </div>

        <!-- 4. Invoice Generator -->
        <div id="tool-invoice" class="tool-view hidden-page">
            <div class="max-w-4xl mx-auto px-4 py-8">
                <button onclick="navigateTo('tools')" class="text-slate-500 hover:text-slate-800 mb-6 flex items-center transition no-print"><i data-lucide="arrow-left" class="h-4 w-4 mr-1"></i> Back to Tools</button>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="lg:col-span-2 print-full">
                        <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-slate-100 tool-container">
                            <!-- Invoice Header -->
                            <div class="flex flex-col md:flex-row justify-between mb-8 border-b pb-6 gap-6">
                                <div class="space-y-2 flex-1">
                                    <h2 class="text-3xl font-bold text-slate-800">INVOICE</h2>
                                    <div class="flex items-center space-x-2"><i data-lucide="user" class="h-4 w-4 text-slate-400"></i><input class="font-bold text-lg text-slate-700 border-b border-dashed border-slate-300 focus:border-blue-500 outline-none bg-transparent w-full" value="Your Company Name"></div>
                                    <div class="flex items-center space-x-2"><i data-lucide="file-badge" class="h-4 w-4 text-slate-400"></i><input class="text-sm text-slate-500 border-b border-dashed border-slate-300 focus:border-blue-500 outline-none bg-transparent w-full" value="GSTIN: XXXXXX"></div>
                                </div>
                                <div class="text-right space-y-2 flex-1">
                                    <div class="flex items-center justify-end space-x-2"><span class="text-sm text-slate-400">Invoice #:</span><input class="font-bold text-slate-700 border-b border-dashed border-slate-300 focus:border-blue-500 outline-none bg-transparent w-32 text-right" value="INV-2024-001"></div>
                                    <div class="flex items-center justify-end space-x-2"><span class="text-sm text-slate-400">Date:</span><input type="date" class="text-slate-600 border-b border-dashed border-slate-300 focus:border-blue-500 outline-none bg-transparent w-32 text-right"></div>
                                    <div class="flex items-center justify-end space-x-2 pt-2"><span class="text-sm text-slate-400">Bill To:</span><input class="font-bold text-slate-700 border-b border-dashed border-slate-300 focus:border-blue-500 outline-none bg-transparent w-48 text-right" value="Client Name"></div>
                                </div>
                            </div>
                            <!-- Items -->
                            <div class="space-y-2 mb-6">
                                <div class="flex gap-4 font-bold text-slate-600 border-b pb-2 mb-2 text-sm">
                                    <div class="flex-grow">Description</div>
                                    <div class="w-24 text-right">Cost</div>
                                    <div class="w-16 text-center">Qty</div>
                                    <div class="w-24 text-right">Total</div>
                                </div>
                                <div id="invoice-items">
                                    <!-- Items injected here -->
                                </div>
                                <button onclick="addInvoiceItem()" class="text-sm text-blue-600 hover:underline pt-2 no-print">+ Add Item Line</button>
                            </div>
                            <!-- Totals -->
                            <div class="flex justify-end border-t pt-4">
                                <div class="text-right w-1/2">
                                    <div class="flex justify-between mb-2"><span class="text-slate-500">Subtotal:</span><span class="font-bold" id="inv-total">₹0.00</span></div>
                                    <div class="flex justify-between border-t border-slate-800 pt-2 text-xl font-bold text-slate-900"><span>Total Due:</span><span id="inv-grand-total">₹0.00</span></div>
                                </div>
                            </div>
                            <button onclick="window.print()" class="mt-8 w-full bg-slate-900 text-white py-3 rounded-lg flex items-center justify-center hover:bg-slate-800 no-print shadow-lg"><i data-lucide="printer" class="mr-2 h-4 w-4"></i> Print / Download PDF</button>
                        </div>
                    </div>
