        toolsGrid.innerHTML = `<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            ${toolsData.map(tool => `
                <div onclick="${tool.isPdf ? `loadPdfTool('${tool.name}')` : `MapsTo('${tool.id}')`}" 
                     class="p-4 border rounded-xl transition cursor-pointer hover:shadow-lg flex items-center space-x-4 ${tool.color} bg-opacity-40">
                    <div class="p-2 bg-white rounded-lg shadow-sm"><i data-lucide="${tool.icon}" class="text-slate-700"></i></div>
                    <span class="font-bold text-slate-800 text-sm">${tool.name}</span>
                </div>
            `).join('')}
        </div>`;
        lucide.createIcons();

        // --- GST Calculator Logic ---
        let gstType = 'exclusive';
        function setGstType(type) {
            gstType = type;
            document.getElementById('btn-exclusive').className = type === 'exclusive' ? "flex-1 py-2 rounded-lg font-medium transition bg-blue-600 text-white" : "flex-1 py-2 rounded-lg font-medium transition bg-slate-100 text-slate-600";
            document.getElementById('btn-inclusive').className = type === 'inclusive' ? "flex-1 py-2 rounded-lg font-medium transition bg-blue-600 text-white" : "flex-1 py-2 rounded-lg font-medium transition bg-slate-100 text-slate-600";
            calculateGST();
        }

        function calculateGST() {
            const amount = parseFloat(document.getElementById('gst-amount').value) || 0;
            const rate = parseFloat(document.getElementById('gst-rate').value) || 18;
            
            let gstVal = 0, net = 0, total = 0;
            
            if (gstType === 'exclusive') {
                gstVal = (amount * rate) / 100;
                net = amount;
                total = amount + gstVal;
            } else {
                gstVal = amount - (amount * (100 / (100 + rate)));
                net = amount - gstVal;
                total = amount;
            }
            
            document.getElementById('gst-net').innerText = `₹${net.toFixed(2)}`;
            document.getElementById('gst-val').innerText = `₹${gstVal.toFixed(2)}`;
            document.getElementById('gst-total').innerText = `₹${total.toFixed(2)}`;
        }

        // --- EMI Calculator Logic ---
        function calculateEMI() {
            const p = parseFloat(document.getElementById('emi-p').value) || 0;
            const r = parseFloat(document.getElementById('emi-r').value) || 0;
            const t = parseFloat(document.getElementById('emi-t').value) || 0;
            
            let emi = 0;
            if (r > 0) {
                const monthlyR = r / 12 / 100;
                emi = p * monthlyR * (Math.pow(1 + monthlyR, t) / (Math.pow(1 + monthlyR, t) - 1));
            } else if (t > 0) {
                emi = p / t;
            }
            
            const totalPay = emi * t;
            const interest = totalPay - p;
            
            document.getElementById('emi-val').innerText = `₹${emi.toFixed(0)}`;
            document.getElementById('emi-interest').innerText = `₹${interest.toFixed(0)}`;
        }

        // --- Discount Calculator Logic ---
        function calculateDiscount() {
            const price = parseFloat(document.getElementById('disc-price').value) || 0;
            const pct = parseFloat(document.getElementById('disc-percent').value) || 0;
            const saved = (price * pct) / 100;
            const final = price - saved;
            
            document.getElementById('disc-saved').innerText = `₹${saved.toFixed(2)}`;
            document.getElementById('disc-final').innerText = `₹${final.toFixed(2)}`;
        }

        // --- Invoice Generator Logic ---
        let invoiceItems = [{ desc: 'Consulting Services', cost: 1000, qty: 1 }];
        
        function renderInvoiceItems() {
            const container = document.getElementById('invoice-items');
            let html = '';
            let total = 0;
            
            invoiceItems.forEach((item, index) => {
                const lineTotal = item.cost * item.qty;
                total += lineTotal;
                html += `
                <div class="flex gap-4 items-center mb-2">
                    <input class="flex-grow p-2 border border-slate-200 rounded outline-none" value="${item.desc}" oninput="updateInvItem(${index}, 'desc', this.value)">
                    <input type="number" class="w-24 p-2 border border-slate-200 rounded text-right outline-none" value="${item.cost}" oninput="updateInvItem(${index}, 'cost', this.value)">
                    <input type="number" class="w-16 p-2 border border-slate-200 rounded text-center outline-none" value="${item.qty}" oninput="updateInvItem(${index}, 'qty', this.value)">
                    <div class="w-24 text-right font-medium text-slate-700">₹${lineTotal.toFixed(2)}</div>
                </div>`;
            });
            container.innerHTML = html;
            document.getElementById('inv-total').innerText = `₹${total.toFixed(2)}`;
            document.getElementById('inv-grand-total').innerText = `₹${total.toFixed(2)}`;
        }

        function addInvoiceItem() {
            invoiceItems.push({ desc: '', cost: 0, qty: 1 });
            renderInvoiceItems();
        }

        function updateInvItem(index, field, val) {
            invoiceItems[index][field] = field === 'desc' ? val : parseFloat(val) || 0;
            renderInvoiceItems(); 
        }
        
        // Initial Render
        renderInvoiceItems();

        // --- Password Generator ---
        function updatePassLen() {
            document.getElementById('pass-len-label').innerText = 'Length: ' + document.getElementById('pass-len').value;
        }
        
        function generatePassword() {
            const len = document.getElementById('pass-len').value;
            const upper = document.getElementById('chk-upper').checked;
            const lower = document.getElementById('chk-lower').checked;
            const num = document.getElementById('chk-num').checked;
            const sym = document.getElementById('chk-sym').checked;
            
            const chars = {
                upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
                lower: 'abcdefghijklmnopqrstuvwxyz',
                num: '0123456789',
                sym: '!@#$%^&*()_+-=[]{}|;:,.<>?'
            };
            
            let valid = '';
            if(upper) valid += chars.upper;
            if(lower) valid += chars.lower;
            if(num) valid += chars.num;
            if(sym) valid += chars.sym;
            
            if(!valid) return;
            
            let pass = '';
            for(let i=0; i<len; i++) {
                pass += valid.charAt(Math.floor(Math.random() * valid.length));
            }
            document.getElementById('pass-output').value = pass;
        }

        function copyPassword() {
            const pass = document.getElementById('pass-output').value;
            if(pass) navigator.clipboard.writeText(pass);
        }

        // --- QR Code ---
        function generateQR() {
            const text = document.getElementById('qr-text').value;
            if(!text) return;
            const url = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(text)}`;
            document.getElementById('qr-img').src = url;
            document.getElementById('qr-result').classList.remove('hidden');
            document.getElementById('qr-result').classList.add('flex');
        }

        async function downloadQR() {
            const src = document.getElementById('qr-img').src;
            try {
                const response = await fetch(src);
                const blob = await response.blob();
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = 'qrcode.png';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } catch (e) { alert("Right click image to save."); }
        }

        // --- Base64 Tool Logic ---
        function b64Encode() {
            const input = document.getElementById('b64-input').value;
            try {
                document.getElementById('b64-output').value = btoa(input);
            } catch(e) {
                document.getElementById('b64-output').value = "Error: Invalid input for Base64 encoding.";
            }
        }
        function b64Decode() {
            const input = document.getElementById('b64-input').value;
            try {
                document.getElementById('b64-output').value = atob(input);
            } catch(e) {
                document.getElementById('b64-output').value = "Error: Invalid Base64 string.";
            }
        }

        // --- JSON Formatter Logic ---
        function formatJson() {
            const input = document.getElementById('json-input').value;
            try {
                const obj = JSON.parse(input);
                document.getElementById('json-output').value = JSON.stringify(obj, null, 2);
                document.getElementById('json-output').classList.remove('text-red-600');
            } catch(e) {
                document.getElementById('json-output').value = "Invalid JSON";
                document.getElementById('json-output').classList.add('text-red-600');
            }
        }

        // --- Word Counter Logic ---
        function countWords() {
            const text = document.getElementById('wc-input').value;
            const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
            const chars = text.length;
            const ns = text.replace(/\s/g, '').length;
            
            document.getElementById('wc-words').innerText = words;
            document.getElementById('wc-chars').innerText = chars;
            document.getElementById('wc-ns').innerText = ns;
        }

        // --- Image Tools Logic ---
        let currentImg = null;
        let originalImgName = 'image';

        function handleImageToolFile(input) {
            if(input.files && input.files[0]) {
                const file = input.files[0];
                originalImgName = file.name.split('.')[0];
                const url = URL.createObjectURL(file);
                const img = new Image();
                img.onload = () => {
                    currentImg = img;
                    document.getElementById('img-width').value = img.width;
                    document.getElementById('img-height').value = img.height;
                    document.getElementById('img-preview').src = url;
                    document.getElementById('img-controls').classList.remove('hidden');
                    document.getElementById('img-upload-area').classList.add('hidden');
                };
                img.src = url;
            }
        }

        function updateImgDims(source) {
            if(!currentImg) return;
            const ratio = document.getElementById('img-ratio').checked;
            const wInput = document.getElementById('img-width');
            const hInput = document.getElementById('img-height');
            
            if(ratio) {
                const aspect = currentImg.width / currentImg.height;
                if(source === 'w') {
                    hInput.value = Math.round(wInput.value / aspect);
                } else {
                    wInput.value = Math.round(hInput.value * aspect);
                }
            }
        }

        function processAndDownloadImage() {
            if(!currentImg) return;
            const canvas = document.createElement('canvas');
            const w = parseInt(document.getElementById('img-width').value);
            const h = parseInt(document.getElementById('img-height').value);
            const format = document.getElementById('img-format').value;
            
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(currentImg, 0, 0, w, h);
            
            const url = canvas.toDataURL(format);
            const link = document.createElement('a');
            link.download = `${originalImgName}-processed.${format.split('/')[1]}`;
            link.href = url;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function resetImgTool() {
            currentImg = null;
            document.getElementById('img-controls').classList.add('hidden');
            document.getElementById('img-upload-area').classList.remove('hidden');
        }

        // --- PDF Tools (Simulation) ---
        let pdfFile = null;
        function loadPdfTool(title) {
            document.getElementById('pdf-tool-title').innerText = title;
            resetPdfTool();
            navigateTo('tool-pdf-generic');
        }

        function handlePdfFile(input) {
            if(input.files && input.files[0]) {
                pdfFile = input.files[0];
                document.getElementById('pdf-filename').innerText = pdfFile.name;
                const btn = document.getElementById('pdf-convert-btn');
                btn.disabled = false;
                btn.classList.remove('bg-slate-200', 'text-slate-400', 'cursor-not-allowed');
                btn.classList.add('bg-blue-600', 'text-white', 'hover:bg-blue-700');
                btn.innerText = "Convert Now";
            }
        }

        function startPdfConversion() {
            document.getElementById('pdf-idle').classList.add('hidden');
            document.getElementById('pdf-processing').classList.remove('hidden');
            
            let width = 0;
            const interval = setInterval(() => {
                width += 5;
                document.getElementById('pdf-progress').style.width = width + '%';
                if(width >= 100) {
                    clearInterval(interval);
                    document.getElementById('pdf-processing').classList.add('hidden');
                    document.getElementById('pdf-done').classList.remove('hidden');
                }
            }, 100);
        }

        function downloadPdfResult() {
            const dummy = "Simulated Converted File Content";
            const blob = new Blob([dummy], {type: 'text/plain'});
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.download = `converted_${Date.now()}.txt`;
            link.href = url;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function resetPdfTool() {
            pdfFile = null;
            document.getElementById('pdf-idle').classList.remove('hidden');
            document.getElementById('pdf-processing').classList.add('hidden');
            document.getElementById('pdf-done').classList.add('hidden');
            document.getElementById('pdf-filename').innerText = "Click to Upload PDF";
            const btn = document.getElementById('pdf-convert-btn');
            btn.disabled = true;
            btn.className = "w-full mt-6 py-4 rounded-lg font-bold text-lg transition bg-slate-200 text-slate-400 cursor-not-allowed";
            btn.innerText = "Select a File First";
            document.getElementById('pdf-progress').style.width = '0%';
        }
        
        // --- Init ---
        // Load Home content initially to duplicate content
        navigateTo('home');

    </script>
</body>
