# Copy to .env.local for local builds. Never commit real values.

# Optional, build-time only: your Apps Script /exec URL. When set,
# `npm run build` copies the current Google Sheet content into the
# pre-built pages (better for social previews). The live website reads the
# sheet in the browser either way — that URL goes in public/site-config.js.
CONTENT_SHEET_URL=

# Canonical site origin (public). Defaults to the website address in the sheet.
VITE_SITE_URL=https://kunnectds.in
