# Copy to .env.local for local development. Never commit real values.
#
# Variables prefixed with VITE_ are embedded in the browser bundle and are
# PUBLIC. Never put secrets (API keys, passwords, tokens) in a VITE_ variable.

# Canonical site origin used for canonical URLs, Open Graph tags and sitemap.xml.
# Defaults to site.seo.siteUrl in src/config/site.ts when unset.
VITE_SITE_URL=https://kunnectds.in
