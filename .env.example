# Copy to .env.local for local development. Never commit real values.
# In production, set these in Netlify → Site configuration → Environment variables.

# ── Google Sheet database (server-side only) ────────────────────────────────
# The Apps Script web-app URL from google-sheets/README.md, including ?key=…
# Used by builds (to read content) and the admin functions (to read/write).
# When empty, builds use the content already in src/content.
CONTENT_SHEET_URL=

# ── Admin panel (/admin.html, server-side only) ─────────────────────────────
# Netlify build hook; "Save & publish" uses it to rebuild the site.
NETLIFY_BUILD_HOOK=
# Owner login. Use a long, unique password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 40+ random letters and numbers; signs login sessions.
SESSION_SECRET=

# ── Public settings ─────────────────────────────────────────────────────────
# Variables prefixed with VITE_ are embedded in the browser bundle and are
# PUBLIC. Never put secrets in a VITE_ variable.
VITE_SITE_URL=https://kunnectds.in
