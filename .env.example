# Copy to .env.local for local development. Never commit real values.

# ── Google Sheets content (build time, server-side only) ────────────────────
# The Apps Script web-app URL from google-sheets/README.md, including ?key=…
# Set it in Netlify → Site configuration → Environment variables.
# When empty, the build uses the content already in src/content.
# This is NOT prefixed with VITE_, so it is never sent to visitors' browsers.
CONTENT_SHEET_URL=

# ── Public settings ─────────────────────────────────────────────────────────
# Variables prefixed with VITE_ are embedded in the browser bundle and are
# PUBLIC. Never put secrets in a VITE_ variable.

# Canonical site origin used for canonical URLs, Open Graph tags and sitemap.xml.
# Defaults to the website address in the sheet's SEO tab.
VITE_SITE_URL=https://kunnectds.in
